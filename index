<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lloyd Frontera - Campanha da Água</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #e0f2fe;
            color: #0369a1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            text-align: center;
            padding: 20px;
        }

        .container {
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(3, 105, 161, 0.2);
            max-width: 500px;
            width: 100%;
            transition: all 0.5s ease;
        }

        .avatar-placeholder {
            width: 120px;
            height: 120px;
            background: #bae6fd;
            border-radius: 50%;
            margin: 0 auto 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 50px;
            border: 4px solid #0284c7;
        }

        h1 {
            font-size: 2rem;
            color: #0c4a6e;
            margin-bottom: 10px;
        }

        .subtitle {
            font-style: italic;
            color: #64748b;
            margin-bottom: 30px;
        }

        .slogan-box {
            background: #f0f9ff;
            border-left: 5px solid #0284c7;
            padding: 15px;
            margin-bottom: 30px;
            border-radius: 0 10px 10px 0;
        }

        .slogan-text {
            font-size: 1.25rem;
            font-weight: bold;
            line-height: 1.6;
            color: #0369a1;
        }

        .btn {
            background: #0284c7;
            color: white;
            border: none;
            padding: 12px 24px;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.3s;
            width: 100%;
        }

        .btn:hover {
            background: #0369a1;
        }

        .campanha-secao {
            display: none;
            margin-top: 20px;
            padding: 20px;
            background: #f0fdf4;
            border: 2px dashed #22c55e;
            border-radius: 12px;
            animation: fadeIn 0.6s ease forwards;
        }

        .campanha-titulo {
            color: #14532d;
            font-size: 1.2rem;
            font-weight: bold;
            margin-bottom: 10px;
        }

